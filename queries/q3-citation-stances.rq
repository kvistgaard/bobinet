# Typed citation relations between works (CiTO)
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX cito: <http://purl.org/spar/cito/>
SELECT ?citing ?stance ?cited
WHERE {
  ?w1 ?p ?w2 .
  FILTER(STRSTARTS(STR(?p), "http://purl.org/spar/cito/"))
  ?w1 rdfs:label ?citing . ?w2 rdfs:label ?cited .
  BIND(REPLACE(STR(?p), ".*/", "") AS ?stance)
}
ORDER BY ?citing
