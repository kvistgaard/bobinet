# External linking coverage: each entity's subject IRI and owl:sameAs links
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?entity ?iri ?sameAs
WHERE {
  VALUES ?cls { schema:Person schema:Organization schema:CreativeWork
                skos:Concept schema:Event schema:Place }
  ?e a ?cls ; rdfs:label ?entity .
  FILTER NOT EXISTS { ?run a prov:Activity ; prov:used ?e }
  OPTIONAL { ?e owl:sameAs ?sameAs }
  BIND(STR(?e) AS ?iri)
}
ORDER BY ?entity
